############################
# 🤖 LLM Configuration
############################
LLM_PROVIDER_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=api-key
LLM_MODEL=gemini-3.5-flash-lite
MAX_TOKENS=4096
TEMPERATURE=0.4


############################
# 🔗 Embeddings
############################
EMBEDDING_PROVIDER_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=1024


############################
# 🧠 Reranker
############################
RERANKER_ENABLE=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L2-v2
TOP_K_RERANK=5


############################
# 📚 RAG Settings
############################
TOP_K_RETRIEVAL=8
HYBRID_ALPHA=0.5


############################
# 📊 LangSmith / LangFuse
############################
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=api-key
LANGSMITH_PROJECT="DreamHybridRAG"


############################
# 🗄️ Database Configuration
############################
DB_HOST=172.17.0.1
DB_PORT=5432
DB_NAME=rag_database
DB_USER=postgres
DB_PASSWORD=admin
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10


############################
# 🧾 Chat History & Summarization
############################
HISTORY_TABLE=chat_messages_history
SUMMARY_TABLE=chat_session_summaries

MAX_HISTORY_MESSAGES=10
SUMMARY_INTERVAL=5
SUMMARY_MODEL=gemini-3.1-flash-lite
SUMMARY_MAX_TOKENS=512